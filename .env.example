APP_NAME="SFTP File Manager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# No database is used by this project.
SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_SAME_SITE=strict
# Set to true when served over HTTPS
SESSION_SECURE_COOKIE=false

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Local dev only: `php artisan serve --no-reload` + workers so progress polling works during downloads.
# PHP_CLI_SERVER_WORKERS=4

# Fast mode (keeps SFTP connections open between clicks)
OCTANE_SERVER=frankenphp
